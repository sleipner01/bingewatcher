{
  "name": "bingewatcher-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "test": "bun run test:unit:no-watch && bun run test:e2e",
    "test:unit": "vitest --dir src",
    "test:unit:no-watch": "vitest run --dir src",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=chromium",
    "coverage": "vitest run --dir src --coverage --reporter=junit --outputFile.junit=./coverage/junit.xml",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@apollo/client": "^3.8.6",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.11",
    "@mui/material": "^5.14.11",
    "@vercel/analytics": "^1.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.1.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^9.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "dotenv": "^18.0.4",
    "jsdom": "^30.1.1",
    "sass": "^1.105.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
