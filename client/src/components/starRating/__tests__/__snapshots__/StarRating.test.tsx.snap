        class="MuiRating-label MuiRating-pristine css-hlbajn-MuiRating-label"
      >
        <input
          class="MuiRating-visuallyHidden"
          id="star-rating-empty"
          name="star-rating"
          type="radio"
          value=""
        />
        <span
          class="MuiRating-visuallyHidden"
        >
          Empty
        </span>
      </label>
    </span>
    <p
      class="_info_fd611d"
    >
      Click on a star to select/change rating. The rating will be saved to your account.
    </p>
  </div>
</div>
`;
