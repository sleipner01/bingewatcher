{
  "name": "bingewatcher",
  "version": "1.0.0",
  "private": true,
  "description": "Bingewatcher",
  "homepage": "https://bingewatcher.magnusbyrkjeland.no",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:client": "bun --filter bingewatcher-frontend dev",
    "dev:server": "bun --filter bingewatcher-server dev",
    "build": "bun --filter bingewatcher-frontend build",
    "typecheck": "bun --filter bingewatcher-frontend typecheck",
    "test": "bun run test:unit && bun run test:server",
    "test:unit": "bun --filter bingewatcher-frontend test:unit",
    "test:server": "bun --filter bingewatcher-server test",
    "test:e2e": "bun --filter bingewatcher-frontend test:e2e",
    "coverage": "bun --filter bingewatcher-frontend coverage",
    "lint": "oxlint --max-warnings 0",
    "lint:style": "stylelint \"client/src/**/*.scss\"",
    "lint:fix": "oxlint --fix && stylelint --fix \"client/src/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run lint:style && bun run format:check && bun run typecheck && bun run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sleipner01/bingewatcher"
  },
  "author": "Team 16 | IT2810 NTNU",
  "license": "ISC",
  "devDependencies": {
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^7.0.2"
  }
}
