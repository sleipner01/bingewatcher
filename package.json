{
  "name": "prosjekt-2",
  "version": "1.0.0",
  "private": true,
  "description": "Bingewatcher",
  "homepage": "https://bingewatcher.magnusbyrkjeland.no",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "client",
    "server"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:client": "bun --filter bingewatcher-frontend dev",
    "dev:server": "bun --filter bingewatcher-server dev",
    "test": "bun --filter '*' test",
    "test:client": "bun --filter bingewatcher-frontend test",
    "test:server": "bun --filter bingewatcher-server test",
    "coverage:client": "bun --filter bingewatcher-frontend coverage",
    "build": "bun run build:client",
    "build:client": "bun --filter bingewatcher-frontend build",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix && stylelint --fix \"**/src/**/*{css, js, ts, tsx, jsx}\"",
    "lint:style": "stylelint \"**/src/**/*{scss, css, js, ts, tsx, jsx}\"",
    "lint:style:fix": "stylelint --fix \"**/src/**/*{css, js, ts, tsx, jsx}\"",
    "format": "prettier --write '**/src/**/*.{ts,tsx,js,jsx,scss,json,css}' --config .prettierrc.cjs",
    "pipeline": "bun install --frozen-lockfile && bun run lint && bun run test:client && bun run test:server && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sleipner01/bingewatcher"
  },
  "author": "Team 16 | IT2810 NTNU",
  "license": "ISC",
  "devDependencies": {
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "postcss-less": "^6.0.0",
    "postcss-lit": "^1.4.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.3.0",
    "typescript": "^7.0.2"
  }
}
