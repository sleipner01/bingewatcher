{
  "name": "prosjekt-2",
  "version": "1.0.0",
  "private": true,
  "description": "Bingewatcher",
  "homepage": "https://bingewatcher.magnusbyrkjeland.no",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "client",
    "server"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:client": "bun --filter bingewatcher-frontend dev",
    "dev:server": "bun --filter bingewatcher-server dev",
    "test": "bun --filter '*' test",
    "test:client": "bun --filter bingewatcher-frontend test",
    "test:server": "bun --filter bingewatcher-server test",
    "coverage:client": "bun --filter bingewatcher-frontend coverage",
    "build": "bun run build:client",
    "build:client": "bun --filter bingewatcher-frontend build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix && stylelint --fix \"**/src/**/*{css, js, ts, tsx, jsx}\"",
    "lint:style": "stylelint \"**/src/**/*{scss, css, js, ts, tsx, jsx}\"",
    "lint:style:fix": "stylelint --fix \"**/src/**/*{css, js, ts, tsx, jsx}\"",
    "format": "prettier --write '**/src/**/*.{ts,tsx,js,jsx,scss,json,css}' --config .prettierrc.cjs",
    "pipeline": "bun install --frozen-lockfile && bun run lint && bun run test:client && bun run test:server && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sleipner01/bingewatcher"
  },
  "author": "Team 16 | IT2810 NTNU",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "postcss-less": "^6.0.0",
    "postcss-lit": "^1.1.0",
    "prettier": "^3.9.9",
    "stylelint": "^15.10.3",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-scss": "^10.0.0",
    "stylelint-scss": "^5.1.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.70.1"
  }
}
